        "content": "extends Node2D\n\n@export var meteor_scene: PackedScene = preload(\"res://scenes/meteor.tscn\")\n\n@onready var meteors_container: Node2D = $Meteors\n\nvar score: int = 0\nvar elapsed_time: float = 0.0\n\nvar spawn_timer: float = 0.0\nvar spawn_interval: float = 1.2\nvar min_spawn_interval: float = 0.45\nvar max_spawn_interval: float = 1.2\n\nfunc _process(delta: float) -> void:\n\telapsed_time += delta\n\tspawn_timer += delta\n\t\n\tif spawn_timer >= spawn_interval:\n\t\t_spawn_meteor()\n\t\t_update_spawn_interval()\n\t\tspawn_timer = 0.0\n\nfunc _spawn_meteor() -> void:\n\tvar meteor = meteor_scene.instantiate()\n\tmeteors_container.add_child(meteor)\n\t\n\tmeteor.position.x = randf_range(45.0, 915.0)\n\tmeteor.position.y = -60.0\n\t\n\t# Randomize variant 0, 1, 2 and speed\n\tvar variant = randi() % 3\n\tvar speed = randf_range(100.0, 300.0)\n\tmeteor.configure(variant, speed)\n\t\n\t# Connect signal for scoring\n\tmeteor.passed.connect(_on_meteor_passed)\n\nfunc _on_meteor_passed(_meteor: Area2D) -> void:\n\tscore += 1\n\nfunc _update_spawn_interval() -> void:\n\t# Gradually approach min_spawn_interval over time\n\t# Simple linear approach for this stage\n\tspawn_interval = lerp(spawn_interval, min_spawn_interval, 0.05)\n",
